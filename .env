# --- Telegram API Credentials (my.telegram.org) ---
API_ID=12345678
API_HASH=your_api_hash_here

# --- Telegram Bot Token (@BotFather) ---
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- Google Gemini AI API Key (aistudio.google.com) ---
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# --- Allowed Group Chat ID (jis group me chalana hai, -100 se start hota hai) ---
ALLOWED_CHAT_IDS=-1001234567890

# --- Owner Telegram User ID (@userinfobot se milti hai) ---
OWNER_ID=123456789

# --- Quiz Timer in Seconds (5 se 600 ke beech) ---
TIMER_SECONDS=30
